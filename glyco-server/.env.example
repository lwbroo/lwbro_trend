# Anthropic — server-side key, never shipped to clients
ANTHROPIC_API_KEY=sk-ant-...
# Override only for tests (points recognition calls at a local stub instead of api.anthropic.com)
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Upstash Redis (REST API) — quota counters + entitlement cache
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# RevenueCat
REVENUECAT_SECRET_API_KEY=sk_...
REVENUECAT_WEBHOOK_SECRET=whsec_or_shared_secret_set_in_revenuecat_dashboard
# The entitlement identifier configured in the RevenueCat dashboard (RevenueCat > Entitlements)
REVENUECAT_ENTITLEMENT_ID=unlimited

# Comma-separated list of allowed browser/webview origins
ALLOWED_ORIGINS=https://lwbroo.github.io,http://localhost:8000

# Free-tier abuse backstop: max analyses per IP per day (default 15). Guards against
# clearing localStorage to farm fresh deviceIds; paying subscribers are exempt.
IP_DAILY_LIMIT=15

PORT=8080
